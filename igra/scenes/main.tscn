[node name="Smarnica" parent="." unique_id=1372909337 instance=ExtResource("43_cjqg0")]
transform = Transform3D(0.26108074, 0, 0, 0, 0.26108074, 0, 0, 0, 0.26108074, -39.1109, 0, 0)
script = ExtResource("2_ro3en")
ime = "Šmarnica"
strupenost = 2
video = ExtResource("38_xljpf")
opisi = Array[String](["OPIS: Šmarnica ali solzica je zelnata trajnica z obsežnimi kolonijami, ki jih tvori preko korenik. Stebla zrastejo iz skupnega listnega tulca, do 30 cm visoko. Pozno pomladi cvetoča stebla imajo grozd s petimi do petnajstimi belimi cvetovi zvonaste oblike. Plodovi so majhne oranžno rdeče jagode.", "Avtohtona je v Evropi in Aziji, v Severni Ameriki pa velja za invazivno vrsto. Raste na vlažnih, s humusom bogatih tleh, v gozdovih, vrtovih in na jasah. Zaradi močnih korenik uspevajo tudi v skalnjakih.", "UPORABA: Šmarnica je zaradi koncentracije srčnih glikozidov smrtno nevarna. Včasih so zelo majhne količine šmarnice uporabljali kot odvajalo, danes pa se jo uporablja le kot okrasno rastlino. Sintetični približek njenemu vonju se uporablja za parfume."])
slike = Array[Texture2D]([ExtResource("5_152kg"), ExtResource("6_r4e17"), ExtResource("4_1epgm")])
