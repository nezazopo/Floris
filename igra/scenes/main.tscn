[node name="Gaber" parent="." unique_id=558343830 instance=ExtResource("43_cjqg0")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -20.994843, 0, 23.284435)
script = ExtResource("30_ro3en")
ime = "Gaber"
video = ExtResource("34_ksmap")
opisi = Array[String](["OPIS: Gaber je listopadno drevo, ki zraste približno od 15 do 25 metrov visoko. Ima gladko, sivkasto deblo in jajčaste dvojno nazobčane liste. Cveti spomladi, njegovi cvetovi pa so združeni v mačice. Plodovi so majhni oreški, obdani z značilnimi listnatimi ovoji.", "KJE RASTE: Razširjen je po večjem delu Evrope. Pogosto raste v mešanih in listnatih gozdovih, na vlažnih travnikih in na pašnikih. Uspeva na vlažnih, tudi poplavnih tleh v senci.", "UPORABA: Gabrov les je izjemno trd. Uporablja se kot živa meja, za izdelavo orodij, glasbil, parketa in drv."])
slike = Array[Texture2D]([ExtResource("31_1epgm"), ExtResource("32_152kg"), ExtResource("33_r4e17")])
