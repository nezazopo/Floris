[node name="bezeg_veja_png" parent="Bezeg" unique_id=1460803000 instance=ExtResource("42_2cjbq")]
transform = Transform3D(0.88425046, 0, 1.5691644, 0, 1.8011597, 0, -1.5691644, 0, 0.88425046, 1.6841717, -0.9135053, -0.29205036)

[node name="SmrdljiviBezeg" parent="." unique_id=909103577 instance=ExtResource("43_cjqg0")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -13.106556, 0, 33.72248)
script = SubResource("GDScript_ids8r")
ime = "Smrdljivi bezeg"
opisi = Array[String](["OPIS: Smrdljivi bezeg ali habat je zelnata trajnica, ki raste od 1 do 2 metra visoko. Njegova stebla so pokončna in rastejo v gostih skupinah iz podzemeljskega stebla (korenike). Listi oddajajo smrdljiv vonj, od tod tudi ime. Socvetje je ploščato, cvetovi pa so drobni, beli in včasih rožnati. Plodovi so majhne črne jagode.", "KJE RASTE: Avtohton je v južni in srednji Evropi, zahodni Aziji in severni Afriki. Raste na sončnih in polsenčnih mestih, na vlažnih in z dušikom bogatih, pogosto ilovnatih tleh.", "UPORABA:Celotna rastlina je strupena in lahko povzroči bruhanje, drisko ter bolečine v trebuhu. Včasih so posušeno koreniko, liste in plodove uporabljali kot odvajalo, v vodi namočene cvetove pa za odganjanje glodalcev, ščurkov in stenic."])
slike = Array[Texture2D]([ExtResource("21_augu2"), ExtResource("22_tm6hj"), ExtResource("23_kf5aa")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_155or"), SubResource("Resource_bfu41"), SubResource("Resource_6nfnn")])

