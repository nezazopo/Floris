[node name="Cemaz" parent="." unique_id=143892718 instance=ExtResource("43_cjqg0")]
script = ExtResource("5_pm3ni")
ime = "Čemaž"
video = ExtResource("17_ygd8o")
opisi = Array[String](["OPIS: Čemaž je lukovka, ki raste od marca do junija. Zraste do največ 30 cm, cveti pa od aprila do maja. Socvetje vsebuje od šest do dvajset cvetov. Bele cvetove sestavlja šest listov in spominja na zvezdo. Njegovi listi so podolgovati in suličasti ter dišijo po česnu.", "Nabira se marca in aprila, preden zacveti. Nanj spominjata šmarnica in jesenski podlesek, ki sta smrtno nevarna. Čemaževi listi imajo dobro vidne peclje, ki posamično rastejo neposredno iz tal. Listna peclja šmarnice rastejo iz skupnega listnega tulca, listi jesenskega podleska pa rastejo posamično in  neposredno iz tal, vendar nimajo nadzemnega peclja", "KJE RASTE: Različne vrste čemaža so avtohtone Evropi in Aziji. Najdemo jih v vlažnejših gozdovih, v senčnih predelih.", "UPORABA: Čemaž je začimba blažjega okusa, ki spominja na sorodnika česen in čebula. Uporablja se v ljudski medicini, ker naj bi imel protivnetne in antibakterijske lastnosti. "])
slike = Array[Texture2D]([ExtResource("7_2wyq8"), ExtResource("9_vxglm"), ExtResource("12_xrs0c"), ExtResource("21_j4bwh")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_4e8e3"), SubResource("Resource_w6a6y"), SubResource("Resource_uya8e")])

