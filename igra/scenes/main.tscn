[node name="JesenskiPodlesek" parent="." unique_id=509629009 instance=ExtResource("43_cjqg0")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -11.483398)
script = ExtResource("25_e755i")
ime = "Jesenski podlesek"
strupenost = 1
video = ExtResource("28_j4bwh")
opisi = Array[String](["OPIS: Jesenski podlesek je gomoljasta trajnica. Čebulica se nahaja do 20 cm globoko pod zemljo in jeseni požene vijolične cvetove. Listi se razvijejo šele naslednjo pomlad. Mladi listi so gladki in mesnati, na čemaž najbolj spominja konec marca in začetek aprila. Med listi se razvijejo mnogosemenske glavice (plodovi). V drugi polovici maja so listi tanki in porumeneli. ", "KJE RASTE: Razširjen je po vsej Sloveniji in večjem delu Evrope. Raste na vlažnih travnikih, ob gozdovih in na pašnikih.", "UPRABA: Jesenski podlesek je zelo strupen zaradi visokih koncentracij kolhicina. Že 5 gramov semen ali listov je lahko smrtno nevarnih. Zasebna uporaba je strogo prepovedana, čeprav se kolhicin v majhnih odmerkih sodobni medicini uporablja v zdravilih na recept predvsem pri akutnih napadih putike (protina) in nekaterih vnetnih boleznih."])
slike = Array[Texture2D]([ExtResource("26_ro3en"), ExtResource("28_xhfw6"), ExtResource("28_e755i")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_673bd"), SubResource("Resource_tc087"), SubResource("Resource_xmrkg")])

