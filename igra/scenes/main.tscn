[node name="Bezeg" type="Node3D" parent="." unique_id=1781087234]
transform = Transform3D(0.5462032, 0, -0.9692753, 0, 1.1125791, 0, 0.9692753, 0, 0.5462032, 0, 0.5330081, 21.84195)
script = ExtResource("15_ids8r")
ime = "Bezeg"
opisi = Array[String](["OPIS: Črni bezeg je grm s suličastimi listi zarezanih robov. Plod je jagoda črne ali temno modre barve. Socvetje je ploščate oblike, sestavlja ga veliko število cvetov. Te so drobni, imajo pet listkov bele barve in pet izstopajočih rumenih prašnikov.", "KJE RASTE: Črni bezeg je zelo razširjena vrsta, avtohtona Evropi, nahaja pa se tudi v Aziji ter Severni Ameriki. Ker mu ustreza dušik, ki nastane med razkrajanjem organskih odpadkov, najbolje uspeva v bližini kmetij.", "UPORABA: Surovi plodovi črnega bezga so rahlo strupeni, zato jih uživamo toplotno obdelane. Iz bezgovih plodov in cvetov pripravljamo različne napitke, čaje, sirupe, sokove in marmelade. V Sloveniji je priljubljena šabesa, osvežilna pijača iz bezgovih cvetov. "])
slike = Array[Texture2D]([ExtResource("16_dnhof"), ExtResource("5_2wyq8"), ExtResource("4_og1vs")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_kjtvk"), SubResource("Resource_ksmap"), SubResource("Resource_ndrjj")])

