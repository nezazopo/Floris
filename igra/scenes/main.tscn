[node name="main" type="Node3D" unique_id=2027404022]

[node name="Dob" type="Node3D" parent="." unique_id=1475397641]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9.71579, 0, 0)
script = ExtResource("3_jscy8")
ime = "Dob"
video = ExtResource("7_fv21b")
opisi = Array[String](["OPIS:  Dob je pri nas najbolj pogost hrast. Zraste tudi preko 50 metrov v višino in ima močno deblo ter krošnjo nepravilne oblike. Lubje je sivo rjave barve z izrazitimi vertikalnimi režami. Ima značilne liste, ki so nepravilnih, zaobljenih oblik. Iz oplojenih cvetov se razvije želod, ki je sestavljen iz dveh delov: skledice ter oreška jajčaste oblike. Tipično živijo do 600 let.", "KJE RASTE:Dob je razširjen po celi Evropi in zahodni Aziji. Uspeva na vlažnih tleh, v nižinskih gozdovih", "Dobov les je izjemno trd in odporen. Sodi med gospodarsko najpomembnejša drevesa, njegov les pa se uporablja za gradnjo plovil, sodov, stavbnega pohištva, pohištva, v gradbeništvu in za talne obloge. Želod se uporablja za krmo živali."])
slike = Array[Texture2D]([ExtResource("5_yq6so"), ExtResource("6_fv21b"), ExtResource("7_tel4y")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_ty1g6"), SubResource("Resource_o7ddy"), SubResource("Resource_1v6qk")])

