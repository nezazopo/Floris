[node name="JesenskiPodlesek" parent="." unique_id=1397879530 instance=ExtResource("43_cjqg0")]
script = ExtResource("25_e755i")
ime = "Jesenski podlesek"
strupenost = 1
opisi = Array[String](["OPIS: Jesenski podlesek je gomoljasta trajnica. Čebulica (gomolj) je od 10 do 20 cm globoko pod zemljo, ki jeseni požene vijolične cvetove, podobne žafranu. Listi se razvijejo šele naslednjo pomlad. Mladi listi so suličasti, gladki in mesnati, na čemaž najbolj spominja konec marca in začetek aprila. Med listi se razvijejo mnogosemenske glavice (plodovi). V drugi polovici maja so listi tanki in porumeneli. ", "KJE RASTE: Razširjen je po vsej Sloveniji in večjem delu Evrope. Raste na vlažnih travnikih, ob gozdovih in na pašnikih.", "UPORABA:Celotna rastlina je zelo strupena zaradi kolhicina, ki se nahaja predvsem v semenih, listih in gomolju. Že 5 gramov semen ali listov je lahko smrtno nevarnih. Znaki zastrupitve so bruhanje, driska, bolečine v trebuhu, motnje krvnega obtoka in ohromelost dihanja. Kolhicin se v sodobni medicini uporablja v zdravilih na recept predvsem pri akutnih napadih putike (protina) in nekaterih vnetnih boleznih."])
slike = Array[Texture2D]([ExtResource("26_ro3en"), ExtResource("28_xhfw6"), ExtResource("28_e755i")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_673bd"), SubResource("Resource_tc087"), SubResource("Resource_xmrkg")])

