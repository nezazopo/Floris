[node name="Dob" parent="." unique_id=1287512197 instance=ExtResource("43_cjqg0")]
script = ExtResource("3_jscy8")
ime = "Dob"
video = ExtResource("2_kjtvk")
opisi = Array[String](["OPIS: Dob je pri nas najpogostejši hrast. Zraste tudi preko 50 metrov v višino in ima močno deblo ter krošnjo nepravilne oblike. Lubje je sivo rjave barve z izrazitimi vertikalnimi režami. Ima značilne liste, ki so nepravilnih, zaobljenih oblik. Iz oplojenih cvetov se razvije želod, ki je sestavljen iz dveh delov: skledice ter oreška jajčaste oblike. Običajno živi do 600 let. ", "KJE RASTE: Dob je razširjen po celi Evropi in zahodni Aziji. Uspeva na vlažnih tleh, v nižinskih gozdovih.", "UPORABA: Dobov les je izjemno trd in odporen. Sodi med gospodarsko najpomembnejša drevesa, njegov les pa se uporablja za gradnjo plovil, sodov, stavbnega pohištva, pohištva, v gradbeništvu in za talne obloge. Želod se uporablja za krmo živali. "])
slike = Array[Texture2D]([ExtResource("6_fv21b"), ExtResource("5_yq6so"), ExtResource("14_a82wo")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_ruytr"), SubResource("Resource_o7pr5"), SubResource("Resource_wxrqn")])

