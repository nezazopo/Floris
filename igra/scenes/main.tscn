[node name="CrniBezeg" parent="." unique_id=1397879530 instance=ExtResource("43_cjqg0")]
script = ExtResource("2_od4ux")
ime = "Črni bezeg"
strupenost = 1
video = ExtResource("3_xljpf")
opisi = Array[String](["OPIS: Črni bezeg je grm s suličastimi listi zarezanih robov. Socvetje sestavlja veliko število cvetov in je ploščate oblike. Te so drobni, imajo pet listkov bele barve in pet izstopajočih rumenih prašnikov. Plod je jagoda črne ali temno modre barve.", "KJE RASTE: Črni bezeg je zelo razširjena vrsta, avtohtona v Evropi, nahaja pa se tudi v Aziji ter Severni Ameriki. Ustrezajo mu suha do vlažna tla bogata s humusom, ilovnata in apnenčasta tla.", "UPORABA: Surovi plodovi črnega bezga so rahlo strupeni, zato jih uživamo toplotno obdelane. Iz bezgovih plodov in cvetov pripravljamo različne napitke, čaje, sirupe, sokove in marmelade. V Sloveniji je priljubljena šabesa, osvežilna pijača iz bezgovih cvetov."])
slike = Array[Texture2D]([ExtResource("16_dnhof"), ExtResource("4_og1vs"), ExtResource("5_2wyq8")])
vpr_odg = Array[ExtResource("6_txyw0")]([SubResource("Resource_ygd8o"), SubResource("Resource_1m7le"), SubResource("Resource_hj4tt")])

